{
  "name": "healthforest",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluación económica en salud: costo-efectividad, Markov y presupuesto. Alternativa libre a TreeAge Pro.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-opener.mjs",
